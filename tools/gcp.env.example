# Settings for tools/gcp-setup.sh and tools/deploy.sh. Copy to local/gcp.env (never committed) and fill in.

PROJECT=kana-dojo-1234                   # the Google Cloud project (staging and the public site share it)
REGION=europe-west2                      # London: Cloud Run, Firestore, images and backups
SERVICE=kana-dojo                        # the public site's Cloud Run service (Firestore database "(default)")
STAGING_SERVICE=kana-dojo-staging        # staging's Cloud Run service…
STAGING_DATABASE=staging                 # …and its own Firestore database

KANA_LOG_DAYS=30                         # shown in the privacy note: Cloud Logging keeps logs 30 days
KANA_CONTACT=                            # optional: an email address shown in the privacy note
BUDGET=15                                # monthly budget alert, in the billing account's currency
