# Settings for tools/gcp-setup.sh and tools/deploy.sh. Copy to local/gcp.env (never committed) and fill in.

PROJECT=kana-dojo-1234                   # the Google Cloud project (staging and the public site share it)
REGION=europe-west2                      # London: Cloud Run, Firestore, images and backups
SERVICE=kana-dojo                        # the public site's Cloud Run service (Firestore database "(default)")
STAGING_SERVICE=kana-dojo-staging        # staging's Cloud Run service…
STAGING_DATABASE=staging                 # …and its own Firestore database
FIREBASE_SITE=kanadojo                   # the public address: https://<this>.web.app (Firebase Hosting in front)

KANA_LOG_DAYS=30                         # shown in the privacy note: Cloud Logging keeps logs 30 days
KANA_CONTACT=                            # optional: an email address shown in the privacy note
KANA_DONATE_URL=                         # optional: e.g. https://buymeacoffee.com/you, linked from the app
BUDGET=15                                # monthly budget alert, in the billing account's currency

# Google's own networks (not Cloud customers'): requests from these are Firebase Hosting passing a visitor's
# request on, so the visitor's address is the one before it (see --proxy-nets in the README).
KANA_PROXY_NETS=142.250.0.0/15,172.217.0.0/16,172.253.0.0/16,216.58.192.0/19,216.239.32.0/19,74.125.0.0/16,64.233.160.0/19,66.102.0.0/20,66.249.64.0/19,108.177.0.0/17,173.194.0.0/16,209.85.128.0/17,35.191.0.0/16,130.211.0.0/22,2001:4860::/32,2404:6800::/32,2607:f8b0::/32,2800:3f0::/32,2a00:1450::/32,2c0f:fb50::/32
